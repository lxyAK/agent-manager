{
  "name": "agent-manager",
  "version": "1.0.0",
  "description": "Multi-agent desktop manager for Claude Code, Codex, OpenCode, Hermes and more",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir"
  },
  "build": {
    "appId": "com.agent-manager.app",
    "productName": "Agent Manager",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "files": [
      "src/**/*",
      "node_modules/@xterm/**/*",
      "node_modules/node-pty/**/*"
    ],
    "extraResources": []
  },
  "keywords": [
    "agent",
    "manager",
    "electron",
    "terminal"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "node-pty": "^1.1.0",
    "uuid": "^14.0.0"
  }
}
